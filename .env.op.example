# 1Password の secret reference を書く env ファイルのテンプレート。
# コピーして .env.op を作り、自分の vault / item / field 名に合わせて書き換える。
#
#   cp .env.op.example .env.op
#   op run --env-file=.env.op -- uv run numa-inbox-zero --account personal auth
#
# .env.op に書かれるのは op:// 参照のみでシークレット本体は含まれないが、
# vault 構成が漏れるのも避けたいので .env.op 自体も gitignore してある。
#
# 1Password 側には、Google Cloud Console からダウンロードした
# OAuth クライアント設定 JSON（{"installed": {...}} 全体）を 1 フィールドに保存する。

NIZ_CREDENTIALS_JSON="op://Private/numa-inbox-zero-oauth/credential"

# TypeSafe（Jev）の API キー。console.typesafe.ai で発行して 1Password に保存する。
# SDK 標準の TYPESAFE_API_KEY でも読めるが、このツールの設定は NIZ_ 接頭辞に揃える。
NIZ_TYPESAFE_API_KEY="op://Private/numa-inbox-zero-typesafe/credential"
