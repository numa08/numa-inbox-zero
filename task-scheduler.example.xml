<?xml version="1.0" encoding="UTF-8"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>numa-inbox-zero: Gmail 受信トレイの自動分類（ログオン時に daemon を常駐起動）</Description>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
      <UserId>DOMAIN\USERNAME</UserId>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>DOMAIN\USERNAME</UserId>
      <!-- S4U: パスワードを保存せず、コンソールウィンドウを出さずにバックグラウンドで実行する -->
      <LogonType>S4U</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <!-- daemon が既に動いている間は新たに起動しない -->
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <!-- 常駐プロセスのため実行時間制限を設けない（既定の制限があると途中で kill される） -->
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <WakeToRun>false</WakeToRun>
    <Enabled>true</Enabled>
    <!-- daemon が異常終了した場合は 1 分後に再起動を試みる -->
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>3</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Windows\System32\wsl.exe</Command>
      <Arguments>-d Ubuntu -e /path/to/numa-inbox-zero/run.sh daemon</Arguments>
    </Exec>
  </Actions>
</Task>
